{% extends 'base.html.twig' %}

{% block title %}Catalogue des films{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Catalogue des films</h1>

    <form method="get" class="row g-3 mb-4">
        <div class="col-md-4">
            <label for="genre" class="form-label">Genre</label>
            <select id="genre" name="genre" class="form-select">
                <option value="">Tous</option>
                {% for genre in genres %}
                    <option value="{{ genre.id }}" {% if genre.id == current_genre %}selected{% endif %}>{{ genre.nom ?? genre.name ?? genre.libelle ?? genre }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-4">
            <label for="annee" class="form-label">Année</label>
            <input type="number" id="annee" name="annee" class="form-control" value="{{ current_annee }}" placeholder="Toutes les années">
        </div>
        <div class="col-md-4">
            <label for="search-term" class="form-label">Recherche avancée</label>
            <input type="search" id="search-term" class="form-control" placeholder="Titre, synopsis…" autocomplete="off">
            <div id="search-suggestions" class="list-group mt-1 d-none"></div>
        </div>
        <div class="col-12 d-flex align-items-end justify-content-end gap-2">
            <button type="submit" class="btn btn-primary">Filtrer</button>
            <a href="{{ path('app_film_index') }}" class="btn btn-secondary">Réinitialiser</a>
        </div>
    </form>

    {% if films is empty %}
        <p>Aucun film trouvé.</p>
    {% else %}
        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% for film in films %}
                <div class="col">
                    <div class="card h-100">
                        {% set affichePath = film.affiche ? asset(film.affiche) : asset('images/banniere.jpg') %}
                        <img src="{{ affichePath }}" class="card-img-top" alt="Affiche de {{ film.titre }}">
                        <div class="card-body">
                            <h5 class="card-title">{{ film.titre }}</h5>
                            <p class="card-text text-muted">
                                {{ film.annee }}{% if film.duree %} • {{ film.duree }} min{% endif %}
                            </p>
                            <p class="card-text small">
                                {{ film.synopsis|length > 120
                                    ? film.synopsis|slice(0, 120) ~ '…'
                                    : film.synopsis
                                }}
                            </p>
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center">
                            <span class="fw-bold">{{ film.prixLocationDefaut }} €</span>
                            <a href="{{ path('app_film_show', {id: film.id}) }}" class="btn btn-sm btn-outline-primary">Détails</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>

        <div id="live-search-results" class="mt-4 d-none">
            <h2 class="h5 mb-3">Résultats instantanés</h2>
            <div class="row row-cols-1 row-cols-md-3 g-4" id="live-results-grid"></div>
        </div>

        <nav aria-label="Pagination" class="mt-4">
            <ul class="pagination">
                <li class="page-item {% if current_page <= 1 %}disabled{% endif %}">
                    <a class="page-link" href="{{ path('app_film_index', app.request.query.all|merge({'page': current_page - 1})) }}">Précédent</a>
                </li>

                {% for p in 1..total_pages %}
                    <li class="page-item {% if p == current_page %}active{% endif %}">
                        <a class="page-link" href="{{ path('app_film_index', app.request.query.all|merge({'page': p})) }}">{{ p }}</a>
                    </li>
                {% endfor %}

                <li class="page-item {% if current_page >= total_pages %}disabled{% endif %}">
                    <a class="page-link" href="{{ path('app_film_index', app.request.query.all|merge({'page': current_page + 1})) }}">Suivant</a>
                </li>
            </ul>
        </nav>
    {% endif %}
</div>
{% endblock %}
