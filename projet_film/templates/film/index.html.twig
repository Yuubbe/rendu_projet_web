{% extends 'base.html.twig' %}

{% block title %}Catalogue des films{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
        <h1 class="mb-0">Catalogue des films</h1>
        <a class="btn btn-success" href="{{ path('app_film_new') }}">+ Ajouter un film</a>
    </div>

    <form method="get" action="{{ path('app_film_index') }}" class="row g-3 mb-4" id="live-filter-form">
        <div class="col-md-4">
            <label for="genre" class="form-label">Genre</label>
            <select id="genre" name="genre" class="form-select">
                <option value="">Tous</option>
                {% for genre in genres %}
                    <option value="{{ genre.id }}" {% if genre.id == current_genre %}selected{% endif %}>{{ genre.nom ?? genre.name ?? genre.libelle ?? genre }}</option>
                {% endfor %}
            </select>
        </div>
        <div class="col-md-4">
            <label for="annee" class="form-label">Année</label>
            <input type="number" id="annee" name="annee" class="form-control" value="{{ current_annee }}" placeholder="Toutes les années">
        </div>
        <div class="col-md-4">
            <label for="search-term" class="form-label">Recherche avancée</label>
            <input type="search" id="search-term" name="q" class="form-control" placeholder="Titre, synopsis…" autocomplete="off" value="{{ current_term|default('') }}">
            <div id="search-suggestions" class="list-group mt-1 d-none"></div>
        </div>
        <div class="col-12 d-flex align-items-end justify-content-end gap-2">
            <button type="submit" id="live-filter-button" class="btn btn-primary">Filtrer</button>
            <a href="{{ path('app_film_index') }}" class="btn btn-secondary">Réinitialiser</a>
        </div>
    </form>

    <div id="live-search-results" class="mt-4">
        <h2 class="h5 mb-3">Résultats instantanés</h2>
        <div id="live-empty" class="alert alert-info d-none">Aucun résultat pour ces filtres.</div>
        <div class="row row-cols-1 row-cols-md-3 g-4" id="live-results-grid">
            {% for film in films %}
                <div class="col">
                    <div class="card h-100">
                        {% set affichePath = film.affiche ? asset(film.affiche) : asset('images/banniere.jpg') %}
                        <img src="{{ affichePath }}" class="card-img-top" alt="Affiche de {{ film.titre }}">
                        <div class="card-body">
                            <h5 class="card-title">{{ film.titre }}</h5>
                            <p class="card-text text-muted">{{ film.annee }}</p>
                            <p class="card-text fw-bold">{{ film.prixLocationDefaut }} €</p>
                        </div>
                        <div class="card-footer d-flex justify-content-between gap-2">
                            <a class="btn btn-sm btn-outline-primary" href="{{ path('app_film_show', {id: film.id}) }}">Détails</a>
                            <form method="post" action="{{ path('app_film_delete', {id: film.id}) }}" onsubmit="return confirm('Supprimer ce film ?');" class="m-0 p-0">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete_film_' ~ film.id) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Supprimer</button>
                            </form>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info mb-0">Aucun film disponible pour le moment.</div>
                </div>
            {% endfor %}
        </div>
    </div>
</div>
{% endblock %}
