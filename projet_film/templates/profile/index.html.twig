{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Mon profil</h1>

    <div class="mb-4">
        <h2 class="h5">Informations</h2>
        <p><strong>Email :</strong> {{ user.email }}</p>
    </div>

    <div>
        <h2 class="h5 mb-3">Historique de mes locations</h2>

        {% if locations is empty %}
            <p>Vous n'avez pas encore de location.</p>
        {% else %}
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Films</th>
                        <th>Total</th>
                    </tr>
                </thead>
                <tbody>
                    {% for location in locations %}
                        <tr>
                            <td>{{ location.dateLocation|date('d/m/Y') }}</td>
                            <td>
                                {% if location.detailLocations is defined %}
                                    <ul class="mb-0">
                                        {% for d in location.detailLocations %}
                                            <li>
                                                {% if d.film is defined and d.film %}
                                                    {{ d.film.titre }} - {{ d.prixJour }} €
                                                {% else %}
                                                    {{ d.prixJour }} €
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    (détails non disponibles)
                                {% endif %}
                            </td>
                            <td>{{ location.locationPrixFinal }} €</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
{% endblock %}
