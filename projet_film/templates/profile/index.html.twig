{% extends 'base.html.twig' %}

{% block title %}Mon profil{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Mon profil</h1>

    <div class="mb-4">
        <h2 class="h5">Informations</h2>
        <p><strong>Email :</strong> {{ user.email }}</p>
    </div>

    <div class="row g-4">
        <div class="col-md-6">
            <h2 class="h5 mb-3">Changer mon mot de passe</h2>

            {% if error %}
                <div class="alert alert-danger">{{ error }}</div>
            {% endif %}
            {% if success %}
                <div class="alert alert-success">{{ success }}</div>
            {% endif %}

            <form method="post" class="card" style="padding: 1rem;">
                <div class="mb-3">
                    <label class="form-label" for="current_password">Mot de passe actuel</label>
                    <input type="password" name="current_password" id="current_password" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="new_password">Nouveau mot de passe</label>
                    <input type="password" name="new_password" id="new_password" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="confirm_password">Confirmer le nouveau mot de passe</label>
                    <input type="password" name="confirm_password" id="confirm_password" class="form-control" required>
                </div>
                <button class="btn btn-primary" type="submit">Mettre à jour</button>
            </form>
        </div>

        <div class="col-md-6">
            <h2 class="h5 mb-3">Historique de mes locations</h2>

            {% if locations is empty %}
                <p>Vous n'avez pas encore de location.</p>
            {% else %}
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Films</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for location in locations %}
                            <tr>
                                <td>{{ location.dateLocation|date('d/m/Y') }}</td>
                                <td>
                                    {% if location.detailLocations is defined %}
                                        <ul class="mb-0">
                                            {% for d in location.detailLocations %}
                                                <li>
                                                    {% if d.film is defined and d.film %}
                                                        {{ d.film.titre }} - {{ d.prixJour }} €
                                                    {% else %}
                                                        {{ d.prixJour }} €
                                                    {% endif %}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% else %}
                                        (détails non disponibles)
                                    {% endif %}
                                </td>
                                <td>{{ location.locationPrixFinal }} €</td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
