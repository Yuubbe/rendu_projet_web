{% extends 'base.html.twig' %}

{% block title %}Mon panier{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Mon panier</h1>

    {% if items is empty %}
        <p>Votre panier est vide.</p>
    {% else %}
        <table class="table table-striped" id="cart-table">
            <thead>
                <tr>
                    <th>Film</th>
                    <th>Jour</th>
                    <th>Prix</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for item in items %}
                    <tr data-index="{{ loop.index0 }}" data-prix="{{ item.prix }}">
                        <td>{{ item.titre }}</td>
                        <td>{{ item.jour }}</td>
                        <td class="prix-cell">{{ item.prix|number_format(2, ',', ' ') }} €</td>
                        <td>
                            <form method="post" action="{{ path('app_cart_remove', { index: loop.index0 }) }}">
                                <button class="btn btn-sm btn-outline-danger" type="submit">Retirer</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
                <strong>Total :</strong>
                <span id="cart-total">{{ total|number_format(2, ',', ' ') }}</span> €
            </div>

            <div class="d-flex gap-2">
                <form method="post" action="{{ path('app_cart_clear') }}">
                    <button class="btn btn-outline-secondary" type="submit">Vider le panier</button>
                </form>

                <form method="post" action="{{ path('app_cart_confirm') }}">
                    <button class="btn btn-success" type="submit">Confirmer la location</button>
                </form>
            </div>
        </div>
    {% endif %}
</div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        (function () {
            const rows = document.querySelectorAll('#cart-table tbody tr');
            const totalSpan = document.getElementById('cart-total');
            if (!rows.length || !totalSpan) {
                return;
            }

            function recalcTotal() {
                let total = 0;
                rows.forEach(row => {
                    const prix = parseFloat(row.dataset.prix || '0');
                    total += prix;
                });
                totalSpan.textContent = total.toFixed(2).replace('.', ',');
            }

            recalcTotal();
        })();
    </script>
{% endblock %}
