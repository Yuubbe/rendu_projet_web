{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}
<section class="presentation">
    <div class="presentation-image">
        <div class="presentation-overlay">
            <h1>Bienvenue sur Site Film de fou !</h1>
            <p>Découvrez les films les plus populaires, ajoutez vos favoris et restez à jour sur vos films préférés.</p>
        </div>
    </div>
</section>

<section class="carousel-section">
    <h2>Films à la une</h2>
    <div class="carousel">
        {# On affiche les 5 premiers films (si dispo), sinon placeholders #}
        {% if films is defined and films|length > 0 %}
            {% set films_a_la_une = films|slice(0, 5) %}
        {% else %}
            {% set films_a_la_une = [] %}
        {% endif %}

        {% for film in films_a_la_une %}
            {% set affichePath = film.affiche ? asset(film.affiche) : asset('images/banniere.jpg') %}
            <div class="carousel-item">
                <img src="{{ affichePath }}" alt="Affiche de {{ film.titre }}">
                <div class="carousel-item-info">
                    <h3>{{ film.titre }}</h3>
                    <p>{{ film.synopsis|length > 80 ? film.synopsis|slice(0, 80) ~ '…' : film.synopsis }}</p>
                </div>
            </div>
        {% else %}
            {% for i in 1..5 %}
                <div class="carousel-item">
                    <img src="https://via.placeholder.com/300x450?text=Film+{{ i }}" alt="Film {{ i }}">
                    <div class="carousel-item-info">
                        <h3>Film {{ i }}</h3>
                        <p>Description du film numéro {{ i }}.</p>
                    </div>
                </div>
            {% endfor %}
        {% endfor %}
    </div>

    <button class="carousel-prev">&#10094;</button>
    <button class="carousel-next">&#10095;</button>
</section>

{% if app.user and recommendations is defined and recommendations|length > 0 %}
<section class="mt-5 container">
    <h2 class="mb-3">Recommandés pour vous</h2>
    <div class="row row-cols-1 row-cols-md-3 g-4">
        {% for film in recommendations %}
            {% set affichePath = film.affiche ? asset(film.affiche) : asset('images/banniere.jpg') %}
            <div class="col">
                <div class="card h-100">
                    <img src="{{ affichePath }}" class="card-img-top" alt="Affiche de {{ film.titre }}">
                    <div class="card-body">
                        <h5 class="card-title">{{ film.titre }}</h5>
                        <p class="card-text text-muted">{{ film.annee }}</p>
                        <p class="card-text">{{ film.synopsis|length > 100 ? film.synopsis|slice(0, 100) ~ '…' : film.synopsis }}</p>
                    </div>
                    <div class="card-footer d-flex justify-content-end gap-2">
                        <a href="{{ path('app_film_show', {id: film.id}) }}" class="btn btn-sm btn-outline-primary">Détails</a>
                        <form method="post" action="{{ path('app_cart_add', {id: film.id}) }}" class="d-inline">
                            <input type="hidden" name="jour" value="lundi">
                            <button class="btn btn-sm btn-success" type="submit">Ajouter</button>
                        </form>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
</section>
{% endif %}

{% endblock %}
