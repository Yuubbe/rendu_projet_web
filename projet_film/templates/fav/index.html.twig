{% extends 'base.html.twig' %}

{% block title %}Mes favoris{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">Mes films favoris</h1>

    {% if favoris is empty %}
        <p>Vous n'avez pas encore de film en favoris.</p>
    {% else %}
        <div class="row row-cols-1 row-cols-md-3 g-4">
            {% for film in favoris %}
                <div class="col">
                    <div class="card h-100">
                        {% if film.affiche %}
                            <img src="{{ asset(film.affiche) }}" class="card-img-top" alt="Affiche de {{ film.titre }}">
                        {% endif %}
                        <div class="card-body">
                            <h5 class="card-title">{{ film.titre }}</h5>
                            <p class="card-text text-muted">
                                {{ film.annee }}{% if film.duree %} • {{ film.duree }} min{% endif %}
                            </p>
                            <p class="card-text small">
                                {{ film.synopsis|length > 120 ? film.synopsis|slice(0, 120) ~ '…' : film.synopsis }}
                            </p>
                        </div>
                        <div class="card-footer d-flex justify-content-between align-items-center">
                            <span class="fw-bold">{{ film.prixLocationDefaut }} €</span>
                            <a href="{{ path('app_film_show', {id: film.id}) }}" class="btn btn-sm btn-outline-primary">Détails</a>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
{% endblock %}
