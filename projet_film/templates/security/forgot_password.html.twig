{% extends 'base.html.twig' %}

{% block title %}Mot de passe oublié{% endblock %}

{% block body %}
<div class="container mt-5" style="max-width: 400px;">
    <h1 class="mb-4">Mot de passe oublié</h1>

    {% if email_sent %}
        <div class="alert alert-success">
            Si un compte existe avec cet email, un lien de réinitialisation vous a été envoyé (simulation).
        </div>
    {% else %}
        <p>Entrez votre adresse email pour recevoir un lien de réinitialisation (simulation).</p>
    {% endif %}

    <form method="post">
        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input type="email" name="email" id="email" class="form-control" required>
        </div>

        <button class="btn btn-primary w-100" type="submit">
            Envoyer
        </button>
    </form>
</div>
{% endblock %}
