<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Welcome!{% endblock %}</title>
        <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 128 128%22><text y=%221.2em%22 font-size=%2296%22>⚫️</text><text y=%221.3em%22 x=%220.2em%22 font-size=%2276%22 fill=%22%23fff%22>sf</text></svg>">
        {% block stylesheets %}
        {% endblock %}

        {% block javascripts %}
            {% block importmap %}{{ importmap('app') }}{% endblock %}
        {% endblock %}
    </head>
    <body>
        <header>
            <a href="{{ path('app_home') }}" class="logo">Site Film de fou</a>
            <nav class="navigation">
                <a href="{{ path('app_home') }}" class="{{ app.request.attributes.get('_route') == 'app_home' ? 'active' : '' }}">Accueil</a>
                <a href="{{ path('app_film_index') }}" class="{{ app.request.attributes.get('_route') == 'app_film_index' ? 'active' : '' }}">Films</a>

                {% if app.user %}
                    {# Liens visibles uniquement si l'utilisateur est connecté #}
                    <a href="{{ path('app_fav') }}" class="{{ app.request.attributes.get('_route') == 'app_fav' ? 'active' : '' }}">Favoris</a>
                    <a href="{{ path('app_profile') }}" class="{{ app.request.attributes.get('_route') == 'app_profile' ? 'active' : '' }}">Profile</a>
                    <form action="{{ path('app_logout') }}" method="post" class="d-inline">
                        <button type="submit" class="btn btn-link nav-logout">Déconnexion</button>
                    </form>
                {% else %}
                    {# Liens visibles uniquement si l'utilisateur n'est pas connecté #}
                    <a href="{{ path('app_login') }}" class="{{ app.request.attributes.get('_route') == 'app_login' ? 'active' : '' }}">Connexion / Inscription</a>
                {% endif %}
            </nav>

        </header>
        {% block body %}{% endblock %}
    </body>
</html>
